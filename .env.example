# Vite solo expone las variables con el prefijo VITE_
VITE_API_URL="http://localhost:3000"
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Opcional: ID de un reproductor propio de Dailymotion (Dailymotion Studio → Players). Sin él, sus videos se abren en dailymotion.com.
VITE_DAILYMOTION_PLAYER_ID=""
# Opcional: "true" activa el inicio de sesión y la conexión con Facebook. Sin ella, sus botones avisan de que la función aún no está disponible.
VITE_FACEBOOK_LOGIN=""
# Opcionales, para la app de Google Play (ver docs/android.md). Sin el prefijo VITE_: solo los lee el build,
# que publica con ellas /.well-known/assetlinks.json. Huellas SHA-256 separadas por comas (clave de subida y de firma de Play).
ANDROID_PACKAGE_ID=""
ANDROID_SHA256_CERT_FINGERPRINTS=""
